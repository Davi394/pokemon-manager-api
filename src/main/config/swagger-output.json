{
  "openapi": "3.0.0",
  "info": {
    "version": "2.0.0",
    "title": "PokéManager API",
    "description": "API para gerenciamento de Pokémons desenvolvida na disciplina Tópicos Especiais em Engenharia de Software (UFF)"
  },
  "servers": [
    {
      "url": "http://localhost:3333/api/v1"
    }
  ],
  "tags": [
    {
      "name": "Pokemons",
      "description": "Catálogo local de Pokémons"
    },
    {
      "name": "Pokedex",
      "description": "Consulta à PokéAPI oficial"
    },
    {
      "name": "Trainers",
      "description": "Treinadores, capturas e times"
    }
  ],
  "paths": {
    "/pokemons": {
      "get": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Lista Pokémons do catálogo local",
        "description": "Endpoint para listar todos os Pokémons cadastrados em memória, com suporte opcional ao filtro por tipo.",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": false,
            "example": "Psychic",
            "description": "Tipo do Pokémon usado como filtro opcional.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de Pokémons retornada com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Pokemon"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Cadastra um Pokémon no catálogo local",
        "description": "Endpoint para cadastrar manualmente uma espécie de Pokémon no catálogo em memória.",
        "responses": {
          "201": {
            "description": "Pokémon criado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Pokémon criado com sucesso!"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Pokemon"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePokemonDto"
              }
            }
          }
        }
      }
    },
    "/pokemons/{id}": {
      "get": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Busca um Pokémon pelo ID",
        "description": "Endpoint para buscar uma espécie de Pokémon do catálogo local a partir do ID informado na URL.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "150",
            "description": "ID do Pokémon."
          }
        ],
        "responses": {
          "200": {
            "description": "Pokémon encontrado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Pokemon"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Atualiza um Pokémon pelo ID",
        "description": "Endpoint para atualizar completamente os dados de um Pokémon existente no catálogo local.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "150",
            "description": "ID do Pokémon."
          }
        ],
        "responses": {
          "200": {
            "description": "Pokémon atualizado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Pokémon atualizado com sucesso!"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Pokemon"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePokemonDto"
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Remove um Pokémon pelo ID",
        "description": "Endpoint para remover uma espécie de Pokémon do catálogo local em memória.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "150",
            "description": "ID do Pokémon."
          }
        ],
        "responses": {
          "204": {
            "description": "Pokémon removido com sucesso."
          },
          "404": {
            "description": "Pokémon não encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/pokedex/search": {
      "get": {
        "tags": [
          "Pokedex"
        ],
        "summary": "Busca um Pokémon na PokéAPI oficial",
        "description": "Consulta a PokéAPI pelo nome e retorna os dados formatados (tipos, imagem e atributos base).",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "example": "pikachu",
            "description": "Nome do Pokémon (maiúsculas são aceitas).",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pokémon encontrado na PokéAPI."
          },
          "400": {
            "description": "Parâmetro name ausente ou inválido."
          },
          "404": {
            "description": "Pokémon não encontrado na PokéAPI."
          },
          "502": {
            "description": "PokéAPI indisponível ou fora do tempo limite."
          }
        }
      }
    },
    "/trainers": {
      "post": {
        "tags": [
          "Trainers"
        ],
        "summary": "Cadastra um novo treinador",
        "description": "",
        "responses": {
          "201": {
            "description": "Treinador cadastrado com sucesso."
          },
          "400": {
            "description": "Dados de entrada inválidos."
          },
          "409": {
            "description": "E-mail já cadastrado."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email",
                  "city"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Ash Ketchum"
                  },
                  "email": {
                    "type": "string",
                    "example": "ash@pallet.com"
                  },
                  "city": {
                    "type": "string",
                    "example": "Pallet"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/trainers/{trainerId}/captures": {
      "post": {
        "tags": [
          "Trainers"
        ],
        "summary": "Captura um Pokémon para o time do treinador",
        "description": "Busca o Pokémon na PokéAPI (imagem, atributos base e tipos) e salva a captura. Limite: 6 Pokémons no time ativo.",
        "parameters": [
          {
            "name": "trainerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID (UUID) do treinador."
          }
        ],
        "responses": {
          "201": {
            "description": "Pokémon capturado com sucesso."
          },
          "400": {
            "description": "Dados de entrada inválidos."
          },
          "404": {
            "description": "Treinador ou Pokémon não encontrado."
          },
          "409": {
            "description": "Time já possui 6 Pokémons."
          },
          "502": {
            "description": "PokéAPI indisponível."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "pokemonName"
                ],
                "properties": {
                  "pokemonName": {
                    "type": "string",
                    "example": "pikachu"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/trainers/{trainerId}/team": {
      "get": {
        "tags": [
          "Trainers"
        ],
        "summary": "Lista o time atual do treinador",
        "description": "",
        "parameters": [
          {
            "name": "trainerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID (UUID) do treinador."
          }
        ],
        "responses": {
          "200": {
            "description": "Time do treinador (até 6 Pokémons)."
          },
          "400": {
            "description": "ID do treinador inválido."
          },
          "404": {
            "description": "Treinador não encontrado."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Pokemon": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "25"
          },
          "name": {
            "type": "string",
            "example": "Pikachu"
          },
          "type": {
            "type": "string",
            "example": "Electric"
          },
          "hp": {
            "type": "number",
            "example": 35
          },
          "attack": {
            "type": "number",
            "example": 55
          },
          "defense": {
            "type": "number",
            "example": 40
          }
        }
      },
      "CreatePokemonDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "25"
          },
          "name": {
            "type": "string",
            "example": "Pikachu"
          },
          "type": {
            "type": "string",
            "example": "Electric"
          },
          "hp": {
            "type": "number",
            "example": 35
          },
          "attack": {
            "type": "number",
            "example": 55
          },
          "defense": {
            "type": "number",
            "example": 40
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "hp",
          "attack",
          "defense"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "statusCode": {
            "type": "number",
            "example": 404
          },
          "message": {
            "type": "string",
            "example": "Pokémon não encontrado no catálogo."
          }
        }
      }
    }
  }
}